# Скопируй этот файл в .env и вставь свои значения. Файл .env в git не попадает.
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Этап 3: токен бота от @BotFather и твой Telegram user id (бот будет слушаться только тебя)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=
